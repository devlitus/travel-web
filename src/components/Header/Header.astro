---
import logoIcon from "../../assets/images/logo-icon-1.svg";
---

<header class="w-full py-3 mt-4">
  <div class="container flex items-center justify-center mx-auto">
    <div class="flex items-center gap-4">
      <img src={logoIcon.src} alt="TravelGen Logo" class="w-8 h-8" />
      <div class="flex flex-col">
        <h1 class="text-2xl font-bold">TravelGen</h1>
        <p class="text-sm text-gray-400">Generador de viajes personalizado</p>
      </div>
    </div>
  </div>
</header>

---
import "./TravelForm.css";

const accommodationOptions = [
  { value: "hotel_boutique", label: "Hotel Boutique", icon: "domain" },
  { value: "cabana_rural", label: "Cabaña Rural", icon: "cabin" },
  { value: "apartamento_lujo", label: "Apartamento Lujo", icon: "apartment" },
  { value: "glamping_lujo", label: "Glamping Lujo", icon: "camping" },
  { value: "hostal_bohemio", label: "Hostal Bohemio", icon: "night_shelter" },
  { value: "villa_privada", label: "Villa Privada", icon: "villa" },
  {
    value: "crucero_estelar",
    label: "Crucero Estelar",
    icon: "directions_boat",
  },
  { value: "refugio_montana", label: "Refugio de Montaña", icon: "landscape" },
  { value: "zen_retreat", label: "Zen Retreat", icon: "self_improvement" },
];

const vibeOptions = [
  { value: "slow_travel", label: "#SlowTravel" },
  { value: "curated_luxury", label: "#CuratedLuxury" },
  { value: "local_immersion", label: "#LocalImmersion" },
  { value: "wilderness", label: "#Wilderness" },
  { value: "gastronomy", label: "#Gastronomy" },
];

const seasonOptions = [
  { value: "spring", label: "Primavera", icon: "eco" },
  { value: "summer", label: "Verano", icon: "wb_sunny" },
  { value: "autumn", label: "Otoño", icon: "nest_eco_leaf" },
  { value: "winter", label: "Invierno", icon: "ac_unit" },
];
---

<form class="travel-form">
  <section class="tf-section">
    <label class="tf-section-tag">01. Destino</label>
    <h2 class="tf-section-title">¿A dónde sueñas?</h2>
    <div class="tf-input-wrapper">
      <input
        class="tf-dest-input"
        id="destination"
        name="destination"
        type="text"
        placeholder="Escribe una ciudad, región o estado de ánimo..."
        autocomplete="off"
        spellcheck="false"
      />
    </div>
  </section>

  <section class="tf-section">
    <label class="tf-section-tag">02. Duración</label>
    <h2 class="tf-section-title">¿Cuánto tiempo?</h2>
    <select name="duration" class="tf-hidden-select">
      <option value="">—</option>
      <option value="weekend">Fin de semana</option>
      <option value="full_week" selected>Semana completa</option>
      <option value="fortnight">Quincena</option>
      <option value="extended">Extendido</option>
    </select>
    <div class="tf-pills">
      <button
        type="button"
        class="tf-pill"
        data-field="duration"
        data-value="weekend"
      >
        Fin de semana
      </button>
      <button
        type="button"
        class="tf-pill tf-active"
        data-field="duration"
        data-value="full_week"
      >
        Semana completa
      </button>
      <button
        type="button"
        class="tf-pill"
        data-field="duration"
        data-value="fortnight"
      >
        Quincena
      </button>
      <button
        type="button"
        class="tf-pill"
        data-field="duration"
        data-value="extended"
      >
        Extendido
      </button>
    </div>
  </section>

  <section class="tf-section">
    <label class="tf-section-tag">03. Alojamiento</label>
    <h2 class="tf-section-title">¿Dónde alojarse?</h2>
    <select name="accommodation" class="tf-hidden-select">
      <option value="">—</option>
      {
        accommodationOptions.map((opt) => (
          <option value={opt.value} selected={opt.value === "zen_retreat"}>
            {opt.label}
          </option>
        ))
      }
    </select>
    <div class="tf-accommodation-grid">
      {
        accommodationOptions.map((opt, index) => (
          <button
            type="button"
            class={`tf-accommodation-card ${index === 8 ? "tf-active" : ""}`}
            data-field="accommodation"
            data-value={opt.value}
          >
            <span class="material-symbols-outlined tf-accommodation-icon">
              {opt.icon}
            </span>
            <p class="tf-accommodation-label">{opt.label}</p>
          </button>
        ))
      }
    </div>
  </section>

  <section class="tf-section">
    <label class="tf-section-tag">04. Presupuesto</label>
    <div class="tf-budget-header">
      <h2 class="tf-section-title">Presupuesto estimado</h2>
      <span class="tf-budget-value" id="budgetDisplay">$4,500</span>
    </div>
    <select name="budget" class="tf-hidden-select">
      <option value="">—</option>
      <option value="500-2000">$500 - $2,000</option>
      <option value="2000-4500" selected>$2,000 - $4,500</option>
      <option value="4500-10000">$4,500 - $10,000</option>
      <option value="10000-20000">$10,000 - $20,000</option>
    </select>
    <div class="tf-range-wrapper">
      <input
        type="range"
        class="tf-range"
        id="budgetRange"
        min="500"
        max="20000"
        step="100"
        value="4500"
      />
      <div class="tf-range-labels">
        <span>$500</span>
        <span>$20,000</span>
      </div>
    </div>
  </section>

  <section class="tf-section">
    <label class="tf-section-tag">05. Vibra</label>
    <h2 class="tf-section-title">Esencia del viaje</h2>
    <select name="vibes" class="tf-hidden-select" multiple>
      <option value="curated_luxury" selected>#CuratedLuxury</option>
    </select>
    <div class="tf-vibes-list">
      {
        vibeOptions.map((opt) => (
          <label class="tf-vibe-item">
            <input
              type="checkbox"
              class="tf-vibe-checkbox"
              name="vibes"
              value={opt.value}
            />
            <span class="tf-vibe-label">{opt.label}</span>
          </label>
        ))
      }
    </div>
  </section>

  <section class="tf-section">
    <label class="tf-section-tag">06. Temporada</label>
    <h2 class="tf-section-title">¿Cuándo?</h2>
    <select name="season" class="tf-hidden-select">
      <option value="">—</option>
      {
        seasonOptions.map((opt) => (
          <option value={opt.value} selected={opt.value === "autumn"}>
            {opt.label}
          </option>
        ))
      }
    </select>
    <div class="tf-season-grid">
      {
        seasonOptions.map((opt, index) => (
          <button
            type="button"
            class={`tf-season-card ${index === 2 ? "tf-active" : ""}`}
            data-field="season"
            data-value={opt.value}
          >
            <span class="material-symbols-outlined tf-season-icon">
              {opt.icon}
            </span>
            <p class="tf-season-name">{opt.label}</p>
          </button>
        ))
      }
    </div>
  </section>

  <section class="tf-submit-section">
    <button type="submit" class="tf-submit-btn">
      <span>Generar Propuesta</span>
      <div class="tf-submit-hover-effect"></div>
    </button>
  </section>
</form>

<link
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
  rel="stylesheet"
/>

<script>
  import { FormHandler } from "./formHandler";
  import { SearchHandler } from "./searchHandler";
  import { initCacheCleanup } from "../../utils/clientCache";

  const form = document.querySelector("form") as HTMLFormElement;

  const formHandler = new FormHandler(form, null);
  const searchHandler = new SearchHandler();

  const selectableFields = ["duration", "accommodation", "season"];

  function syncFromSelects(): void {
    selectableFields.forEach((fieldName) => {
      const select = form.querySelector(
        `select[name="${fieldName}"]`,
      ) as HTMLSelectElement | null;
      if (!select || !select.value) return;
      const activeEl = form.querySelector(
        `[data-field="${fieldName}"][data-value="${select.value}"]`,
      );
      if (activeEl) activeEl.classList.add("tf-active");
    });

    const vibesSelect = form.querySelector(
      'select[name="vibes"]',
    ) as HTMLSelectElement | null;
    if (vibesSelect) {
      const selectedValues = Array.from(vibesSelect.selectedOptions).map(
        (opt) => opt.value,
      );
      selectedValues.forEach((val) => {
        const checkbox = form.querySelector(
          `input[name="vibes"][value="${val}"]`,
        ) as HTMLInputElement | null;
        if (checkbox) checkbox.checked = true;
      });
      updateVibeStyles();
    }
  }

  function syncSelectFromButton(fieldName: string, value: string): void {
    form.querySelectorAll(`[data-field="${fieldName}"]`).forEach((el) => {
      el.classList.remove("tf-active");
    });
    const activeEl = form.querySelector(
      `[data-field="${fieldName}"][data-value="${value}"]`,
    );
    if (activeEl) activeEl.classList.add("tf-active");
    const select = form.querySelector(
      `select[name="${fieldName}"]`,
    ) as HTMLSelectElement | null;
    if (select) {
      select.value = value;
      select.dispatchEvent(new Event("change", { bubbles: true }));
    }
  }

  const selectableButtons = form.querySelectorAll(
    "[data-field]",
  ) as NodeListOf<HTMLButtonElement>;

  selectableButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const fieldName = btn.dataset.field!;
      const value = btn.dataset.value!;
      syncSelectFromButton(fieldName, value);
    });
  });

  const budgetRange = document.getElementById(
    "budgetRange",
  ) as HTMLInputElement;
  const budgetDisplay = document.getElementById("budgetDisplay");

  if (budgetRange && budgetDisplay) {
    budgetRange.addEventListener("input", () => {
      const value = parseInt(budgetRange.value).toLocaleString("en-US");
      budgetDisplay.textContent = `$${value}`;
    });
  }

  function updateVibeStyles(): void {
    const vibeItems = form.querySelectorAll(".tf-vibe-item");
    vibeItems.forEach((item) => {
      const checkbox = item.querySelector(
        "input[type='checkbox']",
      ) as HTMLInputElement;
      const label = item.querySelector(".tf-vibe-label") as HTMLElement;
      if (checkbox.checked) {
        label.classList.add("tf-vibe-label-active");
      } else {
        label.classList.remove("tf-vibe-label-active");
      }
    });
  }

  const vibeCheckboxes = form.querySelectorAll(
    ".tf-vibe-checkbox",
  ) as NodeListOf<HTMLInputElement>;

  vibeCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener("change", () => {
      updateVibeStyles();
      const selectedValues = Array.from(
        form.querySelectorAll(".tf-vibe-checkbox:checked"),
      ) as HTMLInputElement[];
      const vibesSelect = form.querySelector(
        'select[name="vibes"]',
      ) as HTMLSelectElement;
      if (vibesSelect) {
        Array.from(vibesSelect.options).forEach((opt) => {
          opt.selected = selectedValues.some((cb) => cb.value === opt.value);
        });
        vibesSelect.dispatchEvent(new Event("change", { bubbles: true }));
      }
    });
  });

  initCacheCleanup();
  formHandler.loadFromCache();
  syncFromSelects();

  form.addEventListener("input", formHandler.saveToCache);
  form.addEventListener("change", formHandler.saveToCache);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const destination = (form.querySelector("#destination") as HTMLInputElement)
      ?.value;

    if (!destination) {
      (window as any).toast.warning(
        "Destino requerido",
        "Por favor, ingresa un destino antes de continuar.",
      );
      return;
    }

    const formData = new FormData(form);
    const completeFormData: Record<string, any> = {};
    formData.forEach((value, key) => {
      if (completeFormData[key]) {
        if (!Array.isArray(completeFormData[key])) {
          completeFormData[key] = [completeFormData[key]];
        }
        completeFormData[key].push(value);
      } else {
        completeFormData[key] = value;
      }
    });

    const cachedResult = searchHandler.checkCache(completeFormData);
    if (cachedResult) {
      (window as any).toast.info(
        "Usando itinerario guardado",
        "Encontramos un itinerario previo para este destino.",
      );
      const redirectUrl = searchHandler.buildRedirectUrl(
        destination,
        completeFormData,
        completeFormData.activities || [],
      );
      window.location.href = redirectUrl;
      return;
    }

    const submitBtn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const originalText = submitBtn?.textContent || "Generar Propuesta";

    let loadingToastId: number | undefined;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Generando...";
      loadingToastId = (window as any).toast.loading(
        "Creando tu itinerario personalizado...",
      );
    }

    try {
      const result = await searchHandler.submitSearch(completeFormData);

      if (loadingToastId !== undefined) {
        (window as any).toast.dismiss(loadingToastId);
      }

      if (result.success) {
        (window as any).toast.success(
          "¡Itinerario creado!",
          "Redirigiendo a tu aventura...",
        );
        const redirectUrl = searchHandler.buildRedirectUrl(
          destination,
          completeFormData,
          completeFormData.activities || [],
        );
        setTimeout(() => {
          window.location.href = redirectUrl;
        }, 800);
      } else {
        (window as any).toast.error(
          result.error?.message || "Error al generar itinerario",
          result.error?.description,
        );
      }
    } catch (error) {
      if (loadingToastId !== undefined) {
        (window as any).toast.dismiss(loadingToastId);
      }
      console.error("Error inesperado:", error);
      (window as any).toast.error(
        "Error inesperado",
        "Ha ocurrido un error. Por favor, intenta de nuevo.",
      );
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    }
  });
</script>

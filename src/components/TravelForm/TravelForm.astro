---
import FormField from "./FormField.astro";
import ActivitiesSection from "./ActivitiesSection.astro";
import "./TravelForm.css";

const formFields = [
  {
    name: "destination",
    label: "Destino soñado",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>`,
    type: "text" as const,
    placeholder: "¿Dónde sueñas viajar? 🌍",
  },
  {
    name: "budget",
    label: "Presupuesto",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg>`,
    type: "select" as const,
    placeholder: "¿Cuánto quieres invertir? 💸",
    options: [
      { value: "low", label: "💰 Económico" },
      { value: "medium", label: "💰💰 Moderado" },
      { value: "high", label: "💰💰💰 Premium" },
    ],
  },
  {
    name: "duration",
    label: "Duración del viaje",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>`,
    type: "select" as const,
    placeholder: "¿Cuánto tiempo tienes? ⏳",
    options: [
      { value: "weekend", label: "🌙 Fin de semana" },
      { value: "1-week", label: "🌙🌙 1 semana" },
      { value: "2-weeks", label: "🌙🌙🌙 2 semanas" },
      { value: "month", label: "🌙🌙🌙🌙 1 mes o más" },
    ],
  },
  {
    name: "travelStyle",
    label: "Estilo de viaje",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`,
    type: "select" as const,
    placeholder: "¿Cómo te gusta viajar? 🎒",
    options: [
      { value: "backpacking", label: "🎒 Mochilero" },
      { value: "luxury", label: "💎 Lujoso" },
      { value: "family", label: "👨‍👩‍👧‍👦 Familiar" },
      { value: "adventure", label: "🎢 Aventura" },
    ],
  },
  {
    name: "accommodation",
    label: "Alojamiento",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
    type: "select" as const,
    placeholder: "¿Dónde prefieres quedarte? 🏨",
    options: [
      { value: "hotel", label: "🏨 Hotel" },
      { value: "hostel", label: "🏨 Hostal" },
      { value: "apartment", label: "🏨 Apartamento" },
      { value: "resort", label: "🏨 Resort" },
    ],
  },
  {
    name: "season",
    label: "Época preferida",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>`,
    type: "select" as const,
    placeholder: "¿Cuándo quieres viajar? ☀️",
    options: [
      { value: "summer", label: "🌞 Verano" },
      { value: "winter", label: "❄️ Invierno" },
      { value: "spring", label: "🌸 Primavera" },
      { value: "autumn", label: "🍂 Otoño" },
    ],
  },
];
---

<form class="glass-card rounded-2xl max-w-4xl mx-auto p-7">
  <section class="activities-section text-center space-y-2">
    <h2 class="text-3xl font-bold pb-4">Preferencias de Viaje</h2>
    <p class="text-gray-400 mb-7">
      Cada detalle cuenta para crear tu experiencia única
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {formFields.map((field) => <FormField {...field} />)}
    </div>
  </section>
  <hr class="my-12 border-gray-700" />

  <ActivitiesSection />

  <div class="mt-16 text-center">
    <button type="submit" class="submit-btn">
      ✨ Crear Mi Aventura Perfecta ✨
    </button>
    <p class="text-gray-400 text-sm mt-2">
      Prepárate para descubrir destinos increíbles 🌟
    </p>
  </div>
</form>

<script>
  import { FormHandler } from "./formHandler";
  import { SearchHandler } from "./searchHandler";

  const form = document.querySelector("form") as HTMLFormElement;
  const activityButtons = document.querySelectorAll(
    ".activity-btn"
  ) as NodeListOf<HTMLButtonElement>;

  const formHandler = new FormHandler(form, activityButtons);
  const searchHandler = new SearchHandler();

  // Inicializar
  formHandler.loadFromCache();

  // Event listeners
  activityButtons.forEach((button) => {
    button.addEventListener("click", () => {
      button.classList.toggle("active");
      formHandler.saveToCache();
    });
  });

  form.addEventListener("input", formHandler.saveToCache);
  form.addEventListener("change", formHandler.saveToCache);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const completeFormData = formHandler.getFormData();
    const destination = completeFormData.destination as string;

    if (!destination) {
      alert("Por favor, ingresa un destino.");
      return;
    }

    // Verificar cache
    const cachedResult = searchHandler.checkCache(completeFormData);
    if (cachedResult) {
      const redirectUrl = searchHandler.buildRedirectUrl(
        destination,
        completeFormData,
        completeFormData.activities || []
      );
      window.location.href = redirectUrl;
      return;
    }

    // Mostrar loading
    const submitBtn = form.querySelector(
      'button[type="submit"]'
    ) as HTMLButtonElement;
    const originalText = submitBtn?.textContent || "Crear Itinerario";
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Generando itinerario...";
    }

    try {
      const success = await searchHandler.submitSearch(completeFormData);

      if (success) {
        const redirectUrl = searchHandler.buildRedirectUrl(
          destination,
          completeFormData,
          completeFormData.activities || []
        );
        window.location.href = redirectUrl;
      } else {
        alert("Error al generar el itinerario. Por favor, inténtalo de nuevo.");
      }
    } catch (error) {
      console.error("Error:", error);
      alert("Error de conexión. Por favor, verifica tu conexión a internet.");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    }
  });
</script>

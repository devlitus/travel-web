---
interface Props {
  message?: string;
  destination?: string;
}

const { message = "Generando tu itinerario...", destination = "" } =
  Astro.props;
---

<div class="loading-container">
  <div class="loading-spinner"></div>
  <h1 class="text-4xl font-bold mb-4">{message}</h1>
  {
    destination && (
      <p class="text-gray-400">
        Un momento, estamos creando tu aventura personalizada para {destination}
        .
      </p>
    )
  }
</div>

<style>
  .loading-container {
    text-align: center;
    padding: 4rem 0;
  }

  .loading-spinner {
    border: 4px solid rgba(255, 255, 255, 0.1);
    border-left: 4px solid #60a5fa;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    animation: spin 1s linear infinite;
    margin: 0 auto 2rem;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
</style>

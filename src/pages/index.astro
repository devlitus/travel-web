---
import Layout from "../layouts/Layout.astro";
import TravelForm from "../components/TravelForm/TravelForm.astro";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site || Astro.url.origin}/#website`,
      url: Astro.site || Astro.url.origin,
      name: "TravelGen",
      description: "Generador de itinerarios de viaje personalizados con IA",
      inLanguage: "es-ES",
    },
    {
      "@type": "Organization",
      "@id": `${Astro.site || Astro.url.origin}/#organization`,
      name: "TravelGen",
      url: Astro.site || Astro.url.origin,
      logo: {
        "@type": "ImageObject",
        url: `${Astro.site || Astro.url.origin}/favicon.svg`,
      },
      sameAs: [],
    },
    {
      "@type": "WebPage",
      "@id": `${Astro.url.href}#webpage`,
      url: Astro.url.href,
      name: "TravelGen - Generador de Viajes Personalizado con IA",
      isPartOf: { "@id": `${Astro.site || Astro.url.origin}/#website` },
      about: { "@id": `${Astro.site || Astro.url.origin}/#organization` },
      description:
        "Crea itinerarios de viaje personalizados con inteligencia artificial. Descubre destinos, planifica actividades y obtén recomendaciones adaptadas a tu presupuesto.",
      inLanguage: "es-ES",
    },
  ],
};
---

<Layout
  title="TravelGen - Generador de Viajes Personalizado con IA"
  description="Crea itinerarios de viaje personalizados con inteligencia artificial. Descubre destinos, planifica actividades y obtén recomendaciones adaptadas a tu presupuesto y preferencias de viaje."
  keywords="viajes, itinerarios, planificador de viajes, viajes personalizados, destinos turísticos, vacaciones, turismo, IA viajes, generador de itinerarios, planear viaje"
  structuredData={structuredData}
>
  <main class="tf-home">
    <section class="tf-hero">
      <h1 class="tf-hero-title">
        Design your <br />
        <span class="tf-hero-title-accent">next horizon.</span>
      </h1>
      <p class="tf-hero-subtitle">
        Provide the details of your desired escape. Our concierge engine will curate a bespoke itinerary tailored to your specific essence.
      </p>
    </section>
    <TravelForm />
  </main>
</Layout>

<style is:global>
  .tf-home {
    background-color: #0a0a0a;
    color: #e2e2e2;
    min-height: 100vh;
  }

  .tf-hero {
    text-align: center;
    padding: 6rem 1.5rem 4rem;
    max-width: 56rem;
    margin: 0 auto;
  }

  .tf-hero-title {
    font-family: 'Noto Serif', Georgia, serif;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 300;
    color: #e2e2e2;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 2rem;
  }

  .tf-hero-title-accent {
    font-style: italic;
    color: #e9c176;
  }

  .tf-hero-subtitle {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    font-weight: 300;
    color: #bfc8c8;
    line-height: 1.7;
    opacity: 0.8;
    max-width: 28rem;
    margin: 0 auto;
  }
</style>
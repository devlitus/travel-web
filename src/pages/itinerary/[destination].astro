---
import Layout from "../../layouts/Layout.astro";
import { getDestinationHeroImageCached } from "../../utils/unsplashService";
import "../../styles/itinerary.css";

export const prerender = false;

const { destination } = Astro.params;

// Obtener la imagen de hero durante el renderizado del servidor
let heroImageData: { imageUrl: string; originalUrl: string } | null = null;
try {
  heroImageData = await getDestinationHeroImageCached(destination || "");
} catch (error) {
  console.error("Error al cargar imagen de hero:", error);
}

// Formatear el nombre del destino para SEO
const destinationName = destination
  ? destination.charAt(0).toUpperCase() +
    destination.slice(1).replace(/-/g, " ")
  : "tu destino";

// Datos estructurados para la página de itinerario
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TravelAction",
  name: `Itinerario de viaje a ${destinationName}`,
  description: `Itinerario personalizado para viajar a ${destinationName} con recomendaciones de actividades, alojamiento y presupuesto.`,
  target: {
    "@type": "EntryPoint",
    urlTemplate: Astro.url.href,
  },
};
---

<Layout
  title={`Itinerario de Viaje a ${destinationName} - TravelGen`}
  description={`Descubre tu itinerario personalizado para ${destinationName}. Planifica actividades, encuentra alojamiento y gestiona tu presupuesto de viaje con recomendaciones basadas en IA.`}
  keywords={`${destinationName}, itinerario ${destinationName}, viaje a ${destinationName}, qué hacer en ${destinationName}, turismo ${destinationName}, vacaciones ${destinationName}`}
  image={heroImageData?.imageUrl}
  type="article"
  structuredData={structuredData}
>
  <main id="itinerary-container" class="container mx-auto px-4 py-8">
    <div id="loading-state" class="text-center">
      <h1 class="text-4xl font-bold mb-4">Estamos diseñando tu aventura...</h1>
      <p style="color: hsl(var(--muted-foreground));">
        Un momento, el experto en viajes está creando tu itinerario
        personalizado para {destination}.
      </p>
      <div class="loading-spinner">
        <div class="spinner-airplane">✈️</div>
        <div class="loading-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center px-4 py-2 text-white font-medium rounded-lg transition-colors duration-200"
          style="background-color: hsl(var(--secondary)); border: 1px solid hsl(var(--border));"
          onmouseover="this.style.backgroundColor='hsl(var(--primary))'"
          onmouseout="this.style.backgroundColor='hsl(var(--secondary))'"
        >
          <svg
            class="w-4 h-4 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ destination, heroImageData }}>
  document.addEventListener("DOMContentLoaded", async () => {
    const container = document.getElementById("itinerary-container");
    if (!container) return;

    const searchParams = new URLSearchParams(window.location.search);

    const apiRequestData = {
      destination, // Correctamente pasado desde el servidor
      budget: searchParams.get("budget"),
      duration: searchParams.get("duration"),
      travelStyle: searchParams.get("travelStyle"),
      accommodation: searchParams.get("accommodation"),
      season: searchParams.get("season"),
      activities: searchParams.getAll("activities"),
    };

    try {
      const response = await fetch(`/api/search`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(apiRequestData),
      });

      if (!response.ok) {
        const errorText = await response.text();
        throw new Error(
          `Error de la API: ${response.status} ${response.statusText} - ${errorText}`
        );
      }

      const data = await response.json();
      if (data.error) throw new Error(data.error);

      const { itinerary } = data;
      if (!itinerary) throw new Error("No se recibió un itinerario válido.");

      const dailyPlanHtml = itinerary.daily_plan
        ? itinerary.daily_plan
            .map(
              (day) => `
            <div class="day-plan">
              <h3 class="text-2xl font-semibold mb-3 day-title">Día ${day.day}: ${day.title}</h3>
              <div class="activities-grid">
                ${
                  day.activities
                    ? day.activities
                        .map(
                          (activity) => `
                      <div class="activity-card">
                        <h4 class="font-bold text-lg">${activity.time_of_day}</h4>
                        <p class="text-gray-300">${activity.description}</p>
                      </div>`
                        )
                        .join("")
                    : ""
                }
              </div>
            </div>`
            )
            .join("")
        : "<p>No hay plan diario disponible.</p>";

      const travelTipsHtml = itinerary.essential_travel_tips
        ? itinerary.essential_travel_tips
            .map(
              (tip) => `
          <li>
            <strong>${tip.category}:</strong> ${tip.tip}
          </li>`
            )
            .join("")
        : "<li>No hay consejos disponibles en este momento.</li>";

      container.innerHTML = `
        <header class="itinerary-header text-center mb-12">
          <div class="hero-background-container relative rounded-lg overflow-hidden shadow-lg mx-auto max-h-96 h-80">
            <div id="hero-background" class="absolute inset-0 bg-cover bg-center bg-no-repeat${heroImageData && heroImageData.imageUrl ? "" : " bg-gradient-to-r from-blue-600 to-purple-700"}" style="${heroImageData && heroImageData.imageUrl ? `background-image: url(${heroImageData.imageUrl});` : ""}">
              <div class="absolute inset-0 bg-opacity-40"></div>
            </div>
            <div class="relative z-10 flex flex-col justify-center items-center h-full text-white p-8">
              <h1 class="text-5xl font-extrabold mb-2 text-shadow-lg">${
                itinerary.destination_name
              }</h1>
              <p class="text-2xl text-gray-100">${itinerary.country}</p>
            </div>
          </div>
        </header>

        <div class="grid md:grid-cols-3 gap-8 mb-12">
            <div class="info-card"><h2 class="text-xl font-bold mb-2">Duración</h2><p>${
              itinerary.duration_days || "N/A"
            } días</p></div>
            <div class="info-card"><h2 class="text-xl font-bold mb-2">Alojamiento Sugerido</h2><p>${
              itinerary.suggested_accommodation?.type || "N/A"
            }${
              itinerary.suggested_accommodation?.name
                ? ` - ${itinerary.suggested_accommodation.name}`
                : ""
            }</p>${
              itinerary.suggested_accommodation?.estimated_cost_range
                ? `<p class="text-sm text-gray-400">${itinerary.suggested_accommodation.estimated_cost_range}</p>`
                : ""
            }</div>
            <div class="info-card"><h2 class="text-xl font-bold mb-2">Costo Total Estimado</h2><p>${
              itinerary.budget_overview?.total_estimated_cost || "N/A"
            }</p></div>
        </div>
        
        <section id="daily-plan"><h2 class="section-title">Plan Diario</h2>${dailyPlanHtml}</section>
        
        ${
          itinerary.budget_overview
            ? `<section id="budget" class="mt-12">
            <h2 class="section-title">Resumen del Presupuesto</h2>
            <div class="budget-grid">
                <div class="info-card"><strong>Alojamiento:</strong> ${
                  itinerary.budget_overview.accommodation || "N/A"
                }</div>
                <div class="info-card"><strong>Comida:</strong> ${
                  itinerary.budget_overview.food || "N/A"
                }</div>
                <div class="info-card"><strong>Actividades:</strong> ${
                  itinerary.budget_overview.activities || "N/A"
                }</div>
                <div class="info-card"><strong>Transporte:</strong> ${
                  itinerary.budget_overview.transportation || "N/A"
                }</div>
            </div>
        </section>`
            : ""
        }

        <section id="tips" class="mt-12">
            <h2 class="section-title">Consejos de Viaje</h2>
            <ul class="tips-list">${travelTipsHtml}</ul>
        </section>

        <div class="text-center mt-12 mb-8">
            <a href="/" class="inline-flex items-center px-6 py-3 text-white font-medium rounded-lg transition-colors duration-200 shadow-lg" style="background-color: hsl(var(--primary)); border: 1px solid hsl(var(--border));">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Planificar otro viaje
            </a>
        </div>`;
    } catch (e) {
      container.innerHTML = `
        <div class="text-center text-red-400">
          <h1 class="text-4xl font-bold mb-4">Error al Generar Itinerario</h1>
          <p class="mb-4">Hubo un problema al contactar al planificador de viajes.</p>
          <p class="text-sm p-4 rounded-lg" style="background-color: hsl(var(--card)); border: 1px solid hsl(var(--border));"><strong>Detalles:</strong> ${e.message}</p>
          <a href="/" class="mt-8 inline-block text-white font-bold py-2 px-4 rounded" style="background-color: hsl(var(--primary)); border: 1px solid hsl(var(--border));">Volver al inicio</a>
        </div>`;
    }
  });
</script>
